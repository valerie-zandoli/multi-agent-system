{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lynx results handoff v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "data_kind": {
      "enum": [
        "sample",
        "simulation"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "revision_round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "synthetic_experiment"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "duration_months": {
          "type": "integer",
          "minimum": 1
        },
        "start_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "parameters_csv": {
          "type": "string",
          "minLength": 1
        },
        "sources_csv": {
          "type": "string",
          "minLength": 1
        },
        "initial_population": {
          "type": "object",
          "properties": {
            "females": {
              "type": "integer",
              "minimum": 0
            },
            "males": {
              "type": "integer",
              "minimum": 0
            },
            "age_months": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "females",
            "males",
            "age_months"
          ],
          "additionalProperties": false
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "area_km2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "habitat_quality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "area_km2",
              "habitat_quality"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2
        },
        "food_rabbits_per_ha": {
          "type": "number",
          "minimum": 0
        },
        "persistence_rule": {
          "const": "breeding_pair_same_patch_at_end"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "purpose",
        "seed",
        "duration_months",
        "start_month",
        "parameters_csv",
        "sources_csv",
        "initial_population",
        "patches",
        "food_rabbits_per_ha",
        "persistence_rule"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "integer",
            "minimum": 0
          },
          "population": {
            "type": "integer",
            "minimum": 0
          },
          "females": {
            "type": "integer",
            "minimum": 0
          },
          "males": {
            "type": "integer",
            "minimum": 0
          },
          "births": {
            "type": "integer",
            "minimum": 0
          },
          "deaths": {
            "type": "integer",
            "minimum": 0
          },
          "movements": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "month",
          "population",
          "females",
          "males",
          "births",
          "deaths",
          "movements"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "final_animals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sex": {
            "enum": [
              "female",
              "male"
            ]
          },
          "age_months": {
            "type": "integer",
            "minimum": 0
          },
          "patch_id": {
            "type": "string",
            "minLength": 1
          },
          "alive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "sex",
          "age_months",
          "patch_id",
          "alive"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "persisted": {
      "type": "boolean"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "data_kind",
    "seed",
    "revision_round",
    "config",
    "history",
    "final_animals",
    "persisted",
    "assumptions"
  ],
  "additionalProperties": false
}
